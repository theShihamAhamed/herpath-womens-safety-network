{
  "name": "@herpath/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HerPath Express and TypeScript API foundation",
  "engines": {
    "node": ">=22.0.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "node_modules/.cache/mongodb-binaries",
      "disablePostinstall": true
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "user:promote": "tsx src/scripts/promote-user.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "h3-js": "~4.5.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "mongoose": "^9.9.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
